@page "/"
@implements IAsyncDisposable
@inject IJSRuntime JS

<PageTitle>Jampanion Web</PageTitle>

<header class="topbar">
    <div>
        <h1>Jampanion</h1>
        <p>Adaptive jazz backing partner</p>
    </div>
    <div class="status-cluster" aria-live="polite">
        <span class="stage-label">@CurrentStage</span>
        <span class="status-text">@StatusText</span>
    </div>
</header>

<main class="workspace">
    <section class="control-panel" aria-label="Session controls">
        <div class="field song-field">
            <label for="song">Song</label>
            <select id="song" value="@SelectedTune.Id" @onchange="SelectTune" disabled="@IsPlaying">
                @foreach (var tune in Tunes)
                {
                    <option value="@tune.Id">@tune.Title</option>
                }
            </select>
        </div>

        <div class="field tempo-field">
            <label for="tempo">Tempo</label>
            <div class="number-with-unit">
                <input id="tempo" type="number" min="40" max="300" step="1" @bind="TempoBpm" disabled="@IsPlaying" />
                <span>BPM</span>
            </div>
        </div>

        <div class="session-actions">
            <button class="primary" @onclick="StartSessionAsync" disabled="@(IsPlaying || IsLoading)">
                @(IsLoading ? "Loading sound…" : "Start session")
            </button>
            <button @onclick="StopSessionAsync" disabled="@(!IsPlaying)">Stop</button>
            <button class="quiet" @onclick="PanicAsync">Panic</button>
        </div>
    </section>

    <section class="mix-panel" aria-label="Mixer">
        <MixerStrip Name="Piano" Enabled="PianoEnabled" EnabledChanged="OnPianoEnabledChanged"
                    Volume="PianoVolume" VolumeChanged="OnPianoVolumeChanged" />
        <MixerStrip Name="Bass" Enabled="BassEnabled" EnabledChanged="OnBassEnabledChanged"
                    Volume="BassVolume" VolumeChanged="OnBassVolumeChanged" />
        <MixerStrip Name="Drums" Enabled="DrumsEnabled" EnabledChanged="OnDrumsEnabledChanged"
                    Volume="DrumsVolume" VolumeChanged="OnDrumsVolumeChanged" />
    </section>

    <section class="now-playing" aria-label="Current harmony">
        <div>
            <span>Current chord</span>
            <strong>@CurrentChord</strong>
        </div>
        <div>
            <span>Position</span>
            <strong>@PositionText</strong>
        </div>
        <div class="progress-track" aria-hidden="true">
            <div class="progress-fill" style="width:@ProgressPercent.ToString("0.###", CultureInfo.InvariantCulture)%"></div>
        </div>
    </section>

    <section class="chart-panel" aria-label="Chord chart">
        <div class="chart-heading">
            <div>
                <h2>@SelectedTune.Title</h2>
                <p>@SelectedTune.Key · @SelectedTune.TimeSignature · @SelectedTune.AccompanimentStyle</p>
            </div>
            <span>@SelectedTune.Bars.Count bars</span>
        </div>

        <div class="chord-grid">
            @foreach (var bar in SelectedTune.Bars)
            {
                <article class="@BarClass(bar.Index)">
                    @if (!string.IsNullOrWhiteSpace(bar.Section) && IsSectionStart(bar.Index))
                    {
                        <span class="section-mark">@bar.Section</span>
                    }
                    <span class="bar-number">@(bar.Index + 1)</span>
                    <strong>@bar.DisplaySymbol</strong>
                </article>
            }
        </div>
    </section>
</main>

<footer class="app-footer">
    <span>Web audio: SpessaSynth + FluidR3-derived SF3</span>
    <a href="licenses/THIRD_PARTY_NOTICES.txt" target="_blank" rel="noreferrer">Third-party licenses</a>
</footer>

@code {
    private readonly IReadOnlyList<TuneForm> Tunes = TuneCatalog.All;
    private TuneForm SelectedTune = TuneCatalog.Default;
    private IJSObjectReference? _audioModule;
    private CancellationTokenSource? _progressCancellation;
    private WebSessionPlan? _sessionPlan;
    private double _positionSeconds;

    private int TempoBpm { get; set; }
    private bool IsPlaying { get; set; }
    private bool IsLoading { get; set; }
    private string StatusText { get; set; } = "Ready";

    private bool PianoEnabled { get; set; } = true;
    private bool BassEnabled { get; set; } = true;
    private bool DrumsEnabled { get; set; } = true;
    private int PianoVolume { get; set; } = 100;
    private int BassVolume { get; set; } = 100;
    private int DrumsVolume { get; set; } = 100;

    protected override void OnInitialized()
    {
        TempoBpm = SelectedTune.DefaultTempoBpm;
    }

    private string CurrentStage
    {
        get
        {
            if (!IsPlaying || _sessionPlan is null)
            {
                return "Stopped";
            }

            if (_positionSeconds < _sessionPlan.CountInSeconds)
            {
                return "Count in";
            }

            return _sessionPlan.Stages
                .FirstOrDefault(stage => _positionSeconds >= stage.StartSeconds && _positionSeconds < stage.EndSeconds)
                ?.Name ?? "Complete";
        }
    }

    private int CurrentBarIndex
    {
        get
        {
            if (!IsPlaying || _sessionPlan is null || _positionSeconds < _sessionPlan.CountInSeconds)
            {
                return -1;
            }

            var musicalPosition = _positionSeconds - _sessionPlan.CountInSeconds;
            var globalBar = (int)(musicalPosition / _sessionPlan.BarDurationSeconds);
            return globalBar % Math.Max(1, _sessionPlan.BarsPerChorus);
        }
    }

    private string CurrentChord => CurrentBarIndex >= 0
        ? SelectedTune.Bars[CurrentBarIndex].DisplaySymbol
        : "–";

    private string PositionText
    {
        get
        {
            if (_sessionPlan is null)
            {
                return "0:00";
            }

            return $"{FormatTime(_positionSeconds)} / {FormatTime(_sessionPlan.DurationSeconds)}";
        }
    }

    private double ProgressPercent => _sessionPlan is null || _sessionPlan.DurationSeconds <= 0
        ? 0
        : Math.Clamp(_positionSeconds / _sessionPlan.DurationSeconds * 100d, 0d, 100d);

    private void SelectTune(ChangeEventArgs args)
    {
        var id = args.Value?.ToString();
        SelectedTune = TuneCatalog.GetById(id);
        TempoBpm = SelectedTune.DefaultTempoBpm;
        _positionSeconds = 0;
        _sessionPlan = null;
    }

    private async Task StartSessionAsync()
    {
        if (IsPlaying || IsLoading)
        {
            return;
        }

        IsLoading = true;
        StatusText = "Preparing the browser synth";
        try
        {
            _audioModule ??= await JS.InvokeAsync<IJSObjectReference>("import", "./js/jampanion-audio.js");
            _sessionPlan = WebSessionPlanner.BuildFullSession(
                SelectedTune,
                TempoBpm,
                Random.Shared.Next());
            _positionSeconds = 0;

            await _audioModule.InvokeVoidAsync(
                "startSession",
                _sessionPlan.Notes,
                MixerState());

            IsPlaying = true;
            StatusText = "Playing";
            BeginProgressUpdates();
        }
        catch (Exception exception)
        {
            StatusText = $"Audio could not start: {exception.Message}";
        }
        finally
        {
            IsLoading = false;
        }
    }

    private void BeginProgressUpdates()
    {
        _progressCancellation?.Cancel();
        _progressCancellation?.Dispose();
        _progressCancellation = new CancellationTokenSource();
        _ = UpdateProgressAsync(_progressCancellation.Token);
    }

    private async Task UpdateProgressAsync(CancellationToken cancellationToken)
    {
        using var timer = new PeriodicTimer(TimeSpan.FromMilliseconds(125));
        try
        {
            while (await timer.WaitForNextTickAsync(cancellationToken))
            {
                if (_audioModule is null || _sessionPlan is null)
                {
                    return;
                }

                _positionSeconds = await _audioModule.InvokeAsync<double>("getPosition", cancellationToken);
                if (_positionSeconds >= _sessionPlan.DurationSeconds + 0.2d)
                {
                    IsPlaying = false;
                    StatusText = "Session complete";
                    await InvokeAsync(StateHasChanged);
                    return;
                }

                await InvokeAsync(StateHasChanged);
            }
        }
        catch (OperationCanceledException)
        {
        }
        catch (JSDisconnectedException)
        {
        }
    }

    private async Task StopSessionAsync()
    {
        _progressCancellation?.Cancel();
        if (_audioModule is not null)
        {
            await _audioModule.InvokeVoidAsync("stopSession");
        }

        IsPlaying = false;
        StatusText = "Stopped";
        _positionSeconds = 0;
    }

    private async Task PanicAsync()
    {
        _progressCancellation?.Cancel();
        if (_audioModule is not null)
        {
            await _audioModule.InvokeVoidAsync("panic");
        }

        IsPlaying = false;
        StatusText = "All notes off";
        _positionSeconds = 0;
    }

    private async Task OnPianoEnabledChanged(bool enabled)
    {
        PianoEnabled = enabled;
        await PushMixerAsync();
    }

    private async Task OnBassEnabledChanged(bool enabled)
    {
        BassEnabled = enabled;
        await PushMixerAsync();
    }

    private async Task OnDrumsEnabledChanged(bool enabled)
    {
        DrumsEnabled = enabled;
        await PushMixerAsync();
    }

    private async Task OnPianoVolumeChanged(int volume)
    {
        PianoVolume = volume;
        await PushMixerAsync();
    }

    private async Task OnBassVolumeChanged(int volume)
    {
        BassVolume = volume;
        await PushMixerAsync();
    }

    private async Task OnDrumsVolumeChanged(int volume)
    {
        DrumsVolume = volume;
        await PushMixerAsync();
    }

    private async Task PushMixerAsync()
    {
        if (_audioModule is not null)
        {
            await _audioModule.InvokeVoidAsync("setMixer", MixerState());
        }
    }

    private WebMixerState MixerState() => new(
        PianoEnabled,
        BassEnabled,
        DrumsEnabled,
        PianoVolume,
        BassVolume,
        DrumsVolume);

    private string BarClass(int barIndex) => barIndex == CurrentBarIndex ? "chord-bar current" : "chord-bar";

    private bool IsSectionStart(int barIndex) => barIndex == 0 ||
        !string.Equals(
            SelectedTune.Bars[barIndex - 1].Section,
            SelectedTune.Bars[barIndex].Section,
            StringComparison.OrdinalIgnoreCase);

    private static string FormatTime(double seconds)
    {
        var value = TimeSpan.FromSeconds(Math.Max(0d, seconds));
        return $"{(int)value.TotalMinutes}:{value.Seconds:00}";
    }

    public async ValueTask DisposeAsync()
    {
        _progressCancellation?.Cancel();
        _progressCancellation?.Dispose();
        if (_audioModule is not null)
        {
            try
            {
                await _audioModule.InvokeVoidAsync("dispose");
                await _audioModule.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
            }
        }
    }
}
