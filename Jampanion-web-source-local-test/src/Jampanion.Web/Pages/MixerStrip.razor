<div class="mixer-strip">
    <label class="part-toggle">
        <input type="checkbox" checked="@Enabled" @onchange="ToggleEnabled" />
        <span>@Name</span>
    </label>
    <input class="volume-slider"
           aria-label="@($"{Name} volume")"
           type="range"
           min="0"
           max="127"
           step="1"
           value="@Volume"
           @oninput="ChangeVolume" />
    <output>@Volume</output>
</div>

@code {
    [Parameter, EditorRequired] public string Name { get; set; } = string.Empty;
    [Parameter] public bool Enabled { get; set; }
    [Parameter] public EventCallback<bool> EnabledChanged { get; set; }
    [Parameter] public int Volume { get; set; }
    [Parameter] public EventCallback<int> VolumeChanged { get; set; }

    private Task ToggleEnabled(ChangeEventArgs args) =>
        EnabledChanged.InvokeAsync(args.Value is true || string.Equals(args.Value?.ToString(), "true", StringComparison.OrdinalIgnoreCase));

    private Task ChangeVolume(ChangeEventArgs args)
    {
        var parsed = int.TryParse(args.Value?.ToString(), out var value) ? value : Volume;
        return VolumeChanged.InvokeAsync(Math.Clamp(parsed, 0, 127));
    }
}
